pipeline{
    agent any

    parameters{
        string(name: 'ENV',defaultValue: 'Prod',description: 'this is to test...')
    }
        
    stages{
        stage('build-stage'){
            stages{
                stage('checking_code'){
                    steps{
                        sh' echo "hello world"'
                    }
                }
                stage('testing _code'){
                    steps{
                        sh' echo "hello world"'
                    }
                }
            }   
        }
        stage('deploying to one more ENV'){
            stages{
                stage('deploying-to dev'){
                    steps{
                        sh' echo "testing dev"'
                   } 
                }
            }
        }
     }    
}
