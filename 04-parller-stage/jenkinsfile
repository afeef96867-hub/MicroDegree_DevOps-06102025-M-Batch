pipeline{
    agent none
    stages {
        stage('run test'){
            parallel{
                stage('test on windows'){
                    agent any
                    steps {
                        echo "test"
                    }

                }
                stage('test on linux'){
                    agent any
                    steps {
                        echo "test"
                    }

                }
            }
        }
         stage('deployingstage'){
            agent any
            steps {
                echo "test"
                }
            }
        stage('deploying test'){
            parallel{
                stage('test on windows'){
                    agent any
                    steps {
                        echo "test"
                    }

                }
                stage('test on linux'){
                    agent any
                    steps {
                        echo "test"
                    }

                }     
            }
        } 
        stage('deployingtest'){
            agent any
            steps {
                echo "test"
                }
            }    
    }
}

     