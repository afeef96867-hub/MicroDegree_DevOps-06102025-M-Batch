pipeline {
    agent any

    options {
        timestamps()
    }

    parameters {
        choice(
            name: 'terraformAction',
            choices: ['apply', 'destroy'],
            description: 'Choose your terraform action'
        )
    }

    environment {
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
    }

    stages {

        stage('Checkout') {
            steps {
                cleanWs()
                dir('iac-repo') {
                    git branch: 'IAC-project',
                        url: 'https://github.com/afeef96867-hub/MicroDegree_DevOps-06102025-M-Batch.git'
                }
            }
        }

        stage('Terraform Init & Plan') {
            steps {
                dir('iac-repo/main-server') {
                    sh '''
                        terraform init -input=false -upgrade
                        terraform plan -out=tfplan
                        terraform show -no-color tfplan > tfplan.txt
                    '''
                }
            }
        }

        stage('Approval') {
            steps {
                script {
                    def plan = readFile 'iac-repo/main-server/tfplan.txt'
                    input(
                        message: 'Do you want to proceed with Terraform?',
                        parameters: [
                            text(
                                name: 'planReview',
                                description: 'Review Terraform plan',
                                defaultValue: plan
                            )
                        ]
                    )
                }
            }
        }

        stage('Apply or Destroy') {
            steps {
                dir('iac-repo/main-server') {
                    script {
                        if (params.terraformAction == 'apply') {
                            sh 'terraform apply -input=false tfplan'
                        } else {
                            sh 'terraform destroy -auto-approve'
                        }
                    }
                }
            }
        }
    }
}
