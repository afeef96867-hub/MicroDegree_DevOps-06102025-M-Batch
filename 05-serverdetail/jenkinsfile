pipeline{
    agent {
        label 'prod'
    }
    stages{
        stage('host'){
            steps{
                sh 'hostname'
            }
        }
    stage('disk-utilisation'){
            steps{
                sh 'df -kh'
            }
        }
    stage('memory'){
            steps{
                sh 'free -m'
            }
        }
    stage('cpu-utilisation'){
            steps{
                sh'top -bn1 | head -20'
            }
        }
    }
}
    
