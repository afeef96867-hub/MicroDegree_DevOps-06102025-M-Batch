pipeline{
    agent any

    stages{
        stage('hello'){
            steps{
                sh'''
                    echo "first stage"
                '''
            }
        }

         stage('second-stage'){
            steps{
                sh'''
                    echo "second stage"
                '''
            }
        }

         stage('final-stage'){
            steps{
                sh'''
                    echo "final stage"
                '''
            }
         }
    }
}